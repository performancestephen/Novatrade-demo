const express = require("express");
const path = require("path");
const app = express();
app.use(express.json());
app.use(express.static(path.join(__dirname, "../public")));

let accounts = {
  demo: { balance: 1000, invested: 0, pnl: 0, transactions: [] },
};

app.get("/api/account", (req, res) => {
  res.json(accounts.demo);
});

app.post("/api/demo-deposit", (req, res) => {
  const amount = Number(req.body.amount);
  if (!Number.isFinite(amount) || amount <= 0 || amount > 100000)
    return res.status(400).json({ error: "Enter a valid demo amount." });
  accounts.demo.balance += amount;
  accounts.demo.transactions.unshift({
    type: "DEMO DEPOSIT",
    amount,
    status: "SIMULATED",
    time: new Date().toISOString(),
  });
  res.json(accounts.demo);
});

app.post("/api/simulate-trade", (req, res) => {
  const amount = Number(req.body.amount);
  if (!Number.isFinite(amount) || amount <= 0 || amount > accounts.demo.balance)
    return res.status(400).json({ error: "Invalid trade amount." });
  const pnl = Number((amount * (Math.random() * 0.1 - 0.04)).toFixed(2));
  accounts.demo.balance += pnl;
  accounts.demo.pnl += pnl;
  accounts.demo.transactions.unshift({
    type: "BOT TRADE",
    amount,
    pnl,
    status: "SIMULATED",
    time: new Date().toISOString(),
  });
  res.json(accounts.demo);
});

app.post("/api/request-withdrawal", (req, res) => {
  const amount = Number(req.body.amount);
  if (!Number.isFinite(amount) || amount <= 0 || amount > accounts.demo.balance)
    return res.status(400).json({ error: "Invalid withdrawal amount." });
  accounts.demo.balance -= amount;
  accounts.demo.transactions.unshift({
    type: "WITHDRAWAL REQUEST",
    amount,
    status: "DEMO ONLY — NOT SENT",
    time: new Date().toISOString(),
  });
  res.json(accounts.demo);
});

app.listen(3000, () =>
  console.log("Demo platform running on http://localhost:3000")
);
