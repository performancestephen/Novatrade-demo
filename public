* {
  box-sizing: border-box;
}
body {
  margin: 0;
  background: #08111f;
  color: #eaf1ff;
  font-family: Inter, system-ui, Arial;
}
header {
  height: 70px;
  padding: 0 6%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid #1c2a3d;
  background: #091525;
}
.brand {
  font-size: 25px;
  font-weight: 800;
}
.brand span {
  color: #5eead4;
}
.badge {
  font-size: 11px;
  padding: 7px 10px;
  border: 1px solid #31516c;
  border-radius: 999px;
  color: #8ed7ff;
}
main {
  max-width: 1100px;
  margin: auto;
  padding: 30px 18px;
}
.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
  padding: 45px 0;
}
.eyebrow {
  color: #5eead4;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 2px;
}
h1 {
  font-size: clamp(40px, 7vw, 70px);
  line-height: 0.95;
  margin: 10px 0 18px;
}
.sub {
  max-width: 650px;
  color: #9db0c8;
  font-size: 17px;
  line-height: 1.6;
}
.orb {
  width: 210px;
  height: 210px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  text-align: center;
  background: radial-gradient(circle, #153b53, #0b1c2e 60%, #08111f);
  border: 1px solid #25435d;
  box-shadow: 0 0 60px #16475a;
}
.orb b {
  color: #5eead4;
}
.notice {
  padding: 15px 17px;
  border-radius: 12px;
  background: #162437;
  border: 1px solid #29435b;
  color: #c9d6e8;
  margin-bottom: 22px;
}
.grid {
  display: grid;
  grid-template-columns: 1.3fr 1fr;
  gap: 18px;
  margin-bottom: 18px;
}
.card {
  background: #0d1a2b;
  border: 1px solid #20344a;
  border-radius: 16px;
  padding: 22px;
}
.big {
  min-height: 240px;
}
.money {
  font-size: 40px;
  font-weight: 800;
  margin: 8px 0;
}
.positive {
  color: #5eead4;
}
.actions {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-top: 25px;
}
button {
  border: 0;
  border-radius: 9px;
  padding: 12px 17px;
  background: #5eead4;
  color: #06131b;
  font-weight: 800;
  cursor: pointer;
}
.secondary {
  background: #2d4862;
  color: white;
}
.danger {
  background: #f59e9e;
  color: #2b0910;
}
.bot {
  display: flex;
  gap: 10px;
  align-items: center;
}
.dot {
  width: 10px;
  height: 10px;
  background: #5eead4;
  border-radius: 50%;
  box-shadow: 0 0 12px #5eead4;
}
label {
  display: block;
  margin: 15px 0 6px;
  color: #91a6bf;
  font-size: 13px;
}
select,
input {
  width: 100%;
  padding: 12px;
  border-radius: 8px;
  border: 1px solid #29425a;
  background: #091525;
  color: #dce8f5;
}
small,
.muted {
  color: #7f94ad;
}
.feed div,
.tx {
  padding: 10px 0;
  border-bottom: 1px solid #1b2c40;
  color: #b9c8da;
  font-size: 13px;
}
footer {
  text-align: center;
  padding: 35px;
  color: #70839b;
  font-size: 12px;
}
@media (max-width: 700px) {
  .hero {
    padding: 30px 0;
  }
  .orb {
    display: none;
  }
  .grid {
    grid-template-columns: 1fr;
  }
  main {
    padding: 20px 14px;
  }
}





